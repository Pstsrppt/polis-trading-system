FROM node:20-alpine
WORKDIR /app
COPY package.json .
RUN npm install --quiet
COPY . .
ARG NEXT_PUBLIC_GATEWAY_WS=ws://localhost:19000/ws/feed
ARG NEXT_PUBLIC_GATEWAY_URL=http://localhost:19000
ARG NEXT_PUBLIC_MEDIA_URL=http://localhost:19002
ENV NEXT_PUBLIC_GATEWAY_WS=$NEXT_PUBLIC_GATEWAY_WS
ENV NEXT_PUBLIC_GATEWAY_URL=$NEXT_PUBLIC_GATEWAY_URL
ENV NEXT_PUBLIC_MEDIA_URL=$NEXT_PUBLIC_MEDIA_URL
RUN npm run build
CMD ["npm", "start"]
